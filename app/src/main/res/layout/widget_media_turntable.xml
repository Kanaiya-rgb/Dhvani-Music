<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_turntable_bg"
    android:padding="12dp">

    <!-- Turntable Platter and Vinyl Disc -->
    <FrameLayout
        android:id="@+id/widget_vinyl_container"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:background="@drawable/widget_vinyl_disc">

        <!-- Center Album Art as Vinyl Center Label -->
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_artwork"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_preview_art" />
    </FrameLayout>

    <!-- Track info alongside turntable disc -->
    <LinearLayout
        android:id="@+id/widget_turntable_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/widget_vinyl_container"
        android:layout_marginLeft="14dp"
        android:layout_toRightOf="@id/widget_vinyl_container"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="DHVANI HI-FI"
            android:textColor="#80FFB885"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="@string/widget_preview_artist"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Controls Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif"
            android:text="33⅓ RPM • STEREO"
            android:textColor="#4DFFFFFF"
            android:textSize="10sp" />

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_previous"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/widget_button_circle"
            android:contentDescription="@string/widget_play"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/widget_next"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</RelativeLayout>
