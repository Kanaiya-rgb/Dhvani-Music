<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Tells Wi-Fi from mobile data, so the matching quality ceiling applies. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Saving a track to Music outlives the screen it was asked from. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Floating dynamic island overlay over other apps while music plays in background -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Touch feedback. The system's own haptics switch is honoured on top of
         this, so granting it doesn't override a user who turned buzzing off. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Audio effects routing and hardware LoudnessEnhancer overdrive -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Bluetooth audio device discovery and name resolution for Media Output selector -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Setting custom trimmed ringtones -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      In-app updates: handing a downloaded APK to the system installer. The
      per-app "install unknown apps" switch is still the user's to flip; this
      only lets the request reach the installer.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Reading local audio files across the device -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Only for API 28 and below. From 29 the app writes to the shared Music
      folder through MediaStore, which grants access to the rows it created and
      needs no permission at all — and this one stops being grantable there.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- In-app voice search, speech recognition, and song listening -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <!-- Google Quick Search Box for Sound Search / Hum to search -->
        <package android:name="com.google.android.googlequicksearchbox" />
        <intent>
            <action android:name="com.google.android.googlequicksearchbox.MUSIC_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>

        <!-- Standard Android Audio Effect & Equalizer / DSP Control Panel (Global) -->
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <intent>
            <action android:name="android.media.action.OPEN_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
        <intent>
            <action android:name="android.media.action.CLOSE_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>

        <!-- Samsung One UI SoundAlive & Dolby Atmos -->
        <package android:name="com.sec.android.app.soundalive" />
        <intent>
            <action android:name="com.sec.android.app.soundalive.ACTION_SOUND_ALIVE" />
        </intent>

        <!-- Universal OEM Dolby Atmos & Spatial Audio Packages -->
        <package android:name="com.dolby.daxappui" />
        <package android:name="com.dolby.spatialaudio" />
        <package android:name="com.dolby.daxservice" />
        <package android:name="com.dolby.dap" />
        <package android:name="com.motorola.dolby.dolbyui" />
        <package android:name="com.motorola.motoaudio" />
        <package android:name="com.oneplus.sound" />
        <package android:name="com.oplus.sound" />
        <package android:name="com.oplus.audio" />
        <package android:name="com.oplus.multimedia.sound" />
        <package android:name="com.realme.sound" />
        <package android:name="com.miui.audioeffect" />
        <package android:name="com.xiaomi.audioeffect" />
        <package android:name="com.lenovo.dolby" />
        <package android:name="com.lenovo.audioeffect" />
        <package android:name="com.sonymobile.soundenhancement" />
        <package android:name="com.sonyericsson.soundenhancement" />
        <package android:name="com.asus.audiowizard" />
        <package android:name="com.transsion.dolby" />
        <package android:name="com.transsion.soundeffect" />
        <package android:name="com.zte.zmusic" />
        <package android:name="com.zte.audioeffect" />
        <package android:name="com.nothing.audio" />
        <package android:name="com.vivo.audiofx" />
    </queries>

    <application
        android:name=".DhvaniApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DhvaniMusic"
        tools:targetApi="34">

        <!--
          One UI 7+ only routes an app's ongoing notification to Live
          Notifications / the Now Bar if the app opts in here. Ignored by every
          other OEM. Samsung additionally gates the non-media Live Notification
          extras behind a per-package allowlist; the media card does not need it.
        -->
        <meta-data
            android:name="com.samsung.android.support.ongoing_activity"
            android:value="true" />

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          Default portrait locked in MainActivity.onCreate. Handles orientation,
          screenSize and screenLayout changes dynamically for Cinema Fullscreen mode.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode"
            android:theme="@style/Theme.DhvaniMusic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!--
                  What makes the system call this a music app. "Play music" from
                  the assistant, Android Auto's media list and the OEM pickers
                  that put up "Complete action using" all ask for
                  MAIN/APP_MUSIC by name and list whoever answers — a launcher
                  entry alone is not enough, which is why Dhvani Music was missing
                  from that dialog while every other player on the device was in
                  it.
                -->
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              The pre-Lollipop spelling of the same request. Deprecated, and
              still what some OEM shortcuts and headset "open music" buttons
              fire, so it costs one filter to be reachable from them too.
            -->
            <intent-filter>
                <action android:name="android.intent.action.MUSIC_PLAYER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>

            <!--
              "Play <something>" said out loud, and the search a media app is
              handed when the assistant has words but no app in mind. An empty
              query means "play music" with nothing said about what, which is
              resumed rather than searched — see [MusicLink].
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
              YouTube Music links: a song, an album, a playlist or an artist,
              tapped anywhere on the device.

              Not autoVerify. Verification is a claim to *own* these domains,
              which Dhvani Music doesn't — and on Android 12+ an app that has
              verified them (the YouTube Music app itself) takes the link
              without a dialog either way. Declaring the filter is what puts
              Dhvani Music in the "Open with" list once the user turns YT Music's
              "Open supported links" off; the SEND filter below is the path
              that always works, because sharing asks rather than routing.

              One host, not a family of them. Every entry here becomes a line
              the user has to tick under "Supported web addresses", so a
              plausible-looking host that never appears in a real link (a `www.`
              form of this one, say) is a line to tick by mistake instead of the
              one that matters.

              Schemes and paths still multiply out: every scheme × every path
              is accepted, so pairing `music.youtube.com` with `/playlist` and
              `youtu.be` with `.*` in one filter would also claim
              `youtu.be/playlist`, which is nonsense. One filter per host keeps
              paths tied to the host they belong to.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="music.youtube.com" />
                <data android:pathPrefix="/watch" />
                <data android:pathPrefix="/playlist" />
                <data android:pathPrefix="/channel" />
                <data android:pathPrefix="/browse" />
            </intent-filter>

            <!--
              youtu.be short links. Only carry watch targets, never playlists
              or channels, so matching everything after the slash is safe.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="youtu.be" />
            </intent-filter>

            <!--
              Spotify links (playlist, user profile, track, album)
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
                <data android:host="open.spotify.com" />
            </intent-filter>

            <!--
              Session grant callbacks from Zarz / Mornye Turnstile verification
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mornye" android:host="session-grant" />
                <data android:scheme="dhvani" android:host="session-grant" />
            </intent-filter>

            <!--
              Share → Dhvani Music, from YT Music's own share sheet or from
              anywhere a link can be sent. The text is whatever the sending app
              wrote around the URL, so the URL is picked out of it rather than
              parsed whole.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- App Icon Launcher Aliases (Dhvani dynamic launcher switcher) -->
        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityLiquidGlass"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_liquid_glass"
            android:roundIcon="@mipmap/ic_launcher_liquid_glass_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCosmicCrystal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cosmic_crystal"
            android:roundIcon="@mipmap/ic_launcher_cosmic_crystal_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivitySmokyAmber"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_smoky_amber"
            android:roundIcon="@mipmap/ic_launcher_smoky_amber_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityCyberpunkNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cyberpunk_neon"
            android:roundIcon="@mipmap/ic_launcher_cyberpunk_neon_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityMonochrome"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_monochrome"
            android:roundIcon="@mipmap/ic_launcher_monochrome_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityRoyalGold"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_royal_gold"
            android:roundIcon="@mipmap/ic_launcher_royal_gold_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityStealthBlack"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_stealth_black"
            android:roundIcon="@mipmap/ic_launcher_stealth_black_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Downloads. Not exported: it is started by the app and by its own
          cancel action, and nothing outside has any business queueing work.
        -->
        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          Home-screen widgets. Two providers so the picker lists a 2×2 and a 4×2,
          both of which are the same widget resized — see MediaWidget.

          Not exported, which is correct for a widget provider despite the
          launcher being the one that talks to it: the system delivers
          APPWIDGET_UPDATE to providers regardless, and the button PendingIntents
          are sent with this app's own identity. Exporting them would only make
          the update broadcast reachable by anything on the device.
        -->
        <receiver
            android:name=".widget.MediaWidgetSquare"
            android:exported="false"
            android:label="@string/widget_square_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_square" />
        </receiver>

        <receiver
            android:name=".widget.MediaWidgetWide"
            android:exported="false"
            android:label="@string/widget_wide_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_wide" />
        </receiver>

        <!-- New Custom Widget 1: Minimal Capsule / Pill Player (4x1) -->
        <receiver
            android:name=".widget.MediaWidgetPill"
            android:exported="false"
            android:label="@string/widget_pill_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_pill" />
        </receiver>

        <!-- New Custom Widget 2: Retro Vinyl Turntable Player (3x3) -->
        <receiver
            android:name=".widget.MediaWidgetTurntable"
            android:exported="false"
            android:label="@string/widget_turntable_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_media_turntable" />
        </receiver>

        <!-- The transport buttons. Reached only by this app's own PendingIntents. -->
        <receiver
            android:name=".widget.MediaWidgetActions"
            android:exported="false" />

        <!--
          Hands the Replay poster to whichever app the user picks to send it
          with. The authority is derived from the applicationId rather than
          written out, because the dev and prod flavours are two packages that
          can be installed side by side — a fixed authority would make the
          second install fail outright with INSTALL_FAILED_CONFLICTING_PROVIDER.

          Not exported, and grantUriPermissions is the whole mechanism: the
          receiving app gets a read grant that arrives with the intent, covers
          one file (see @xml/file_paths) and expires with it.

          Also serves the downloaded update APK to the system installer
          without it needing broad storage access — its own cache-only scope,
          nothing else shared through it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase Cloud Messaging service for instant update notifications -->
        <service
            android:name=".data.DhvaniFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
